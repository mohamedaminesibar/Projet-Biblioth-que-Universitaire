# ==============================================================================
# BiblioEST - Variables d'Environnement (Exemple sans secrets)
# ==============================================================================

# Mode d'exécution
NODE_ENV="development"
PORT=3000

# URL de l'application
# En production, renseignez l'URL Cloud Run ou le domaine de l'école EST
APP_URL="http://localhost:3000"

# Configuration Google AI Studio / Gemini API (injecté automatiquement côté serveur)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Base de Données Relationnelle PostgreSQL (Pour la persistance de production)
DATABASE_URL="postgresql://est_user:est_password@localhost:5432/biblio_est"

# Paramètres Métier Configurables (EST)
VITE_MAX_ACTIVE_LOANS=3
VITE_LOAN_DURATION_DAYS=14
VITE_MAX_RESERVATIONS=2
VITE_PICKUP_WINDOW_HOURS=48
VITE_DELAY_THRESHOLD_YELLOW=1
VITE_DELAY_THRESHOLD_ORANGE=4
VITE_DELAY_THRESHOLD_RED=8
